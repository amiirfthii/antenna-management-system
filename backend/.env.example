# Application
APP_NAME=Antenna Management System
APP_VERSION=2.0.0
DEBUG=True

# Local web database (default)
USE_SQLITE=True
SQLITE_PATH=antenna_management.db

# Remote database (optional, for future server)
# USE_SQLITE=False
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/antenna_db?charset=utf8mb4

# Security
SECRET_KEY=your-secret-key-change-this-in-production-please-use-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
BACKEND_CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# File Uploads
MAX_UPLOAD_SIZE=10485760
